{
  "name": "video-lahirnya-nahwu",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "remotion studio",
    "timing": "python3 scripts/make-timing.py",
    "sfx": "bash scripts/make-sfx.sh",
    "render": "remotion render src/index.ts Nahwu out/nahwu.mp4 --codec=h264 --audio-codec=aac --crf=18",
    "still": "remotion still src/index.ts Nahwu out/preview.png --frame=300",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "@remotion/google-fonts": "4.0.539",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
